PORT=4000
DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety
JWT_SECRET=change-me-to-a-long-random-string
# Timezone used to decide what "today" is when checking for future dates
APP_TIMEZONE=Asia/Kolkata
# Optional: enables report caching and is required for the reminder worker
REDIS_URL=redis://localhost:6379
REPORT_CACHE_TTL=600
# Daily reminder time (cron, evaluated in APP_TIMEZONE) - default 8 PM
REMINDER_CRON=0 20 * * *
